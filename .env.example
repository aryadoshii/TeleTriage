# Copy this to .env and fill in your keys (all free to obtain)

# Groq (primary generative backend) - https://console.groq.com
# Free tier: 30 req/min on Llama 3.3 70B, ~500 tokens/sec
GROQ_API_KEY=

# Google AI Studio (backup generative) - https://aistudio.google.com/app/apikey
# Free tier: generous limits on Gemini 2.0 Flash
GOOGLE_API_KEY=

# Optional: HuggingFace token for gated models
HF_TOKEN=

# Runtime config
TELETRIAGE_ENV=development   # development | production
TELETRIAGE_LOG_LEVEL=INFO    # DEBUG | INFO | WARNING | ERROR
