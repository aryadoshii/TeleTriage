# Copy this to .env and fill in your keys (all free to obtain)

# Groq (primary generative backend) - https://console.groq.com
# Free tier: 30 req/min on Llama 3.3 70B, ~500 tokens/sec
# Used by tier 2 (RAG synthesis, retrieval_tier.py).
GROQ_API_KEY=

# Optional second Groq key, used by tier 3 (generative_tier.py) ONLY —
# a separate account/key so tier 2 and tier 3 draw from independent
# 12,000 TPM pools instead of competing for one. If left blank,
# GenerativeTier falls back to GROQ_API_KEY above (shared, no isolation)
# with a one-time startup warning — the system still works fine with
# just one Groq key, just without the isolation benefit.
GROQ_API_KEY_TIER3=

# Google AI Studio (fallback-of-last-resort generative) - https://aistudio.google.com/app/apikey
# Free tier is request-count limited (as low as 5 req/min, 20 req/day
# depending on model) — fine as an occasional fallback, NOT viable as a
# tier's primary backend under real traffic.
GOOGLE_API_KEY=

# Runtime config
TELETRIAGE_ENV=development   # development | production
